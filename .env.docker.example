# ANetBBS Configuration — Docker variant
# Copy this file to .env (next to docker-compose.yml) and customize.
# Same format as the bare-metal .env.example, plus a few Docker-only
# additions marked below. See docs/22-containers.md for the full guide.

# Environment (development, production, testing)
FLASK_ENV=production

# Secret key for sessions (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-this-in-production

# Database URL — in Docker, ANETBBS_DB_URL (below) is what actually
# matters; every container's entrypoint fails loudly if it's unset.
# Keep this identical to ANETBBS_DB_URL for consistency.
DATABASE_URL=sqlite:////app/data/anetbbs.db

# --- Docker-only settings -----------------------------------------------
# ANETBBS_DB_URL must be set to the SAME absolute path in every
# container — this is what makes 5 separate containers safely share
# one SQLite file (see docker/entrypoint.sh and docs/22-containers.md).
ANETBBS_DB_URL=sqlite:////app/data/anetbbs.db
# Which image + tag to run. ghcr.io/anetonline/anetbbs:latest is the
# EVENTUAL published location once releases are actually tagged and
# pushed there -- it doesn't exist yet. Until then, build locally
# (`docker build -f docker/Dockerfile -t anetbbs:local .`) and point
# these two at that instead:
#   ANETBBS_IMAGE=anetbbs
#   ANETBBS_IMAGE_TAG=local
ANETBBS_IMAGE=ghcr.io/anetonline/anetbbs
ANETBBS_IMAGE_TAG=latest
# Absolute HOST path to the directory containing docker-compose.yml and
# this .env file. Only needed for the self-upgrade panel button — it
# lets the updater container bind-mount the same files by their real
# host path. Defaults to wherever you run `docker compose up` from;
# only set this explicitly if that's not reliable on your setup (e.g.
# a cron job or systemd unit that launches compose from a different
# working directory each time).
ANETBBS_COMPOSE_DIR=/path/to/this/directory
# --------------------------------------------------------------------------

# Telnet Server Settings
TELNET_ENABLED=true
TELNET_HOST=0.0.0.0
TELNET_PORT=2233

# SSH Server Settings
SSH_ENABLED=true
SSH_HOST=0.0.0.0
SSH_PORT=2234
# Path to SSH host key file (auto-generated on first run if missing) —
# lives on the shared anetbbs_data volume, persists across container
# recreation same as the SQLite DB.
SSH_HOST_KEY_FILE=data/ssh_host_key

# rlogin Server Settings (INSECURE — disabled by default). If you
# enable this, also uncomment the "513:513" line for the `terminal`
# service in docker-compose.yml.
RLOGIN_ENABLED=false
RLOGIN_HOST=0.0.0.0
RLOGIN_PORT=513

# FTP server — disabled by default. Passive-mode NAT traversal
# (masquerade_address) isn't implemented yet, so FTP under Docker's
# default bridge networking is a known rough edge — see
# docs/22-containers.md before enabling this in a container deployment.
FTP_ENABLED=false
FTP_HOST=0.0.0.0
FTP_PORT=21
FTP_ANON_ENABLED=true
FTP_TLS_CERTFILE=
FTP_TLS_KEYFILE=
FTP_PASV_PORTS=40000-40050
FTP_ROOT_DIR=data/ftp_root
FTP_BANNER=ANetBBS FTP — file areas

# Web Server Settings
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Application Settings
BBS_NAME=ANetBBS
BBS_DESCRIPTION=A Modern BBS System
# Public domain (used for outbound netmail / nodelist links / share URLs)
BBS_DOMAIN=
# Public hostname clients should reach you at (overrides BBS_DOMAIN if set)
BBS_PUBLIC_HOST=
SYSOP_NAME=Sysop
BBS_EMAIL=
BBS_LOCATION=Earth
BBS_NODES=8
IDLE_TIMEOUT_SECONDS=0
AFK_WARNING_SECONDS=0

# Logging
LOG_LEVEL=INFO

# Finger Server Settings — the finger container's own environment: in
# docker-compose.yml overrides FINGER_LISTEN_PORT to 1079 internally
# (unprivileged, remapped to the real port 79 via Docker's port
# publish), so the value here doesn't matter for that container, but
# keep it for any tooling that reads .env directly.
FINGER_LISTEN_HOST=0.0.0.0
FINGER_LISTEN_PORT=79

# BinkP Server Settings (FidoNet inbound mailer)
BINKP_LISTEN_HOST=0.0.0.0
BINKP_LISTEN_PORT=24554
BINKP_OUR_ADDRESS=
BINKP_SYSTEM_NAME=ANetBBS

# Optional ClamAV virus scan on file uploads — NOT supported inside
# containers for v1 (shells out to a local clamscan binary, not
# bundled in the image). See docs/22-containers.md.
CLAMSCAN_PATH=/usr/bin/clamscan

# IRC client / bridge: comma-separated list of #channels to log
IRC_LOG_CHANNELS=

# New User Verification (NUV) — email/sysop approval gate
NUV_ENABLED=false

# Files: minimum upload-to-download ratio (0 = disabled)
RATIO_MIN=0

# Games Settings — DOSBox/Mystic/Node.js door games are NOT bundled in
# the Docker image for v1 (see docs/22-containers.md); these paths
# won't resolve to anything inside the container and those specific
# door types will gracefully report themselves unavailable.
GAMES_ENABLED=true
GAMES_MAX_NODES=10
GAMES_SESSION_TIMEOUT=3600
DOSBOX_PATH=/usr/bin/dosbox
DOSEMU_PATH=/usr/bin/dosemu
NODEJS_PATH=/usr/bin/node
MYSTIC_PYTHON_PATH=
MYSTIC_BBS_PATH=/usr/local/bin/mystic

# Echomail Settings
ECHOMAIL_ENABLED=true
ECHOMAIL_POLL_ENABLED=true
ECHOMAIL_ORIGIN_LINE=ANetBBS - A Modern BBS System
ECHOMAIL_TEAR_LINE=--- ANetBBS

# MRC Bridge Settings — MRC_BRIDGE_HOST MUST be your public domain, NOT
# the "mrc-bridge" compose service name: the browser connects to the
# bridge's WebSocket directly, it's not proxied through Flask. Setting
# this to the compose service name (unreachable from outside Docker's
# internal network) is a real mistake to watch for.
MRC_BRIDGE_HOST=your-bbs-domain.example.com
MRC_BRIDGE_PORT=8080
MRC_BRIDGE_USE_SSL=false
MRC_BRIDGE_WS_PATH=/mrcws

# Inter-BBS Instant Messaging (MSP / RFC 1312) + SYSTAT (Synchronet
# IMSG companion). Both privileged ports — handled via the web
# service's cap_add: [NET_BIND_SERVICE] in docker-compose.yml.
MSP_PORT=18
SYSTAT_PORT=11

# ANetBBS federation registry / ANotherNetwork QWK hub
REGISTRY_MODE_ENABLED=false
REGISTRY_URL=https://bbs.a-net.fyi
REGISTRY_SELF_REGISTER=false
