[Unit]
Description=ANetBBS BinkP Inbound Listener
After=network.target

[Service]
Type=simple
User=anetbbs
Group=anetbbs
WorkingDirectory=/opt/anetbbs
EnvironmentFile=/opt/anetbbs/.env
ExecStart=/opt/anetbbs/venv/bin/python -m anetbbs.echomail.binkp_server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
