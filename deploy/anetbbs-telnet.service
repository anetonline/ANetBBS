# DEPRECATED -- DO NOT USE. Kept only as a historical reference/
# deprecation warning, found stale (missing every hardening directive
# the current unit has) during a security/performance audit. Superseded
# by anetbbs.service (a single combined process for telnet/ssh/rlogin,
# gated by the *_ENABLED vars in .env). Using this alongside
# anetbbs-ssh.service breaks: Ubuntu systemd applies EnvironmentFile
# AFTER Environment= (the opposite of documented precedence), so the
# Environment= overrides below never actually take effect, and both
# units end up racing for the same ports. See anetbbs.service's own
# comment for the full explanation.
[Unit]
Description=ANetBBS Telnet Server (DEPRECATED, see header comment)
After=network.target

[Service]
Type=simple
User=anetbbs
Group=anetbbs
WorkingDirectory=/opt/anetbbs
EnvironmentFile=/opt/anetbbs/.env
# Explicitly own ONLY the telnet listener — the SSH service unit owns SSH,
# and rlogin is opt-in via the SSH unit. Without these, both services
# would race for ports 2233/2234 if .env enables them all.
Environment=TELNET_ENABLED=true
Environment=SSH_ENABLED=false
Environment=RLOGIN_ENABLED=false
ExecStart=/opt/anetbbs/venv/bin/anetbbs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
