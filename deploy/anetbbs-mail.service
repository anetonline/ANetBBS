# Reference template only -- install.sh and update.sh both generate the
# real unit file inline (heredoc) with the actual $SERVICE_USER/
# $INSTALL_DIR substituted for this install, and neither script ever
# copies this file directly. Kept in sync by hand with install.sh's own
# generated block, same convention as deploy/anetbbs-finger.service; that
# script remains the single source of truth if these two ever disagree.
# If you're installing manually on a non-default user/path, replace every
# `anetbbs`/`/opt/anetbbs` below with your own values before installing
# this.
#
# Port 25 is a dramatically hotter target than Finger's port 79 -- it's
# the one unauthenticated, directly internet-facing listener in this
# whole BBS that strangers are actively scanning for and will probe
# the moment DNS points at it. Many cloud VPS providers also block
# inbound and/or outbound port 25 by default; confirm with your host
# before enabling this unit. See docs/19-email.md.
[Unit]
Description=ANetBBS Internet Mail (SMTP receiver, RFC 5321)
After=network.target

[Service]
Type=simple
User=anetbbs
Group=anetbbs
WorkingDirectory=/opt/anetbbs
EnvironmentFile=/opt/anetbbs/.env
# Listening on TCP 25 requires CAP_NET_BIND_SERVICE; granted via the
# systemd capability below so we don't need to run as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
# Sockets the daemon needs: IPv4/IPv6 listener + DNSBL lookups, AF_UNIX
# for journald (audit F-24).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
# Pure network daemon, no subprocess spawning -- safe for the full
# strict baseline, same reasoning as anetbbs-finger.service's own
# template.
ProtectSystem=strict
ReadWritePaths=/opt/anetbbs/data /opt/anetbbs/logs
ProtectClock=yes
ProtectHostname=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ExecStart=/opt/anetbbs/venv/bin/python -m anetbbs.mail.smtp_server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
