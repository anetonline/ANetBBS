# Reference template only -- install.sh and update.sh both generate the
# real unit file inline (heredoc) with the actual $SERVICE_USER/
# $INSTALL_DIR substituted for this install, and neither script ever
# copies this file directly. Kept in sync by hand with install.sh's own
# generated block (a real security/performance audit found this file had
# drifted -- missing every systemd sandboxing directive install.sh
# actually writes); install.sh remains the single source of truth if
# these two ever disagree again. If you're installing manually on a
# non-default user/path, replace every `anetbbs`/`/opt/anetbbs` below
# with your own values before installing this.
[Unit]
Description=ANetBBS Web Application (eventlet WSGI)
After=network.target

[Service]
Type=simple
User=anetbbs
Group=anetbbs
WorkingDirectory=/opt/anetbbs
EnvironmentFile=/opt/anetbbs/.env
# CAP_NET_BIND_SERVICE lets the unprivileged service user bind to the
# privileged ports MSP (TCP/18) and SYSTAT/ActiveUser (UDP/11). Without
# this, those listeners fail to bind and inter-BBS IM is broken silently.
# We intentionally do NOT set CapabilityBoundingSet here so that sudo
# (used by the Service Control Center) can still escalate.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# NoNewPrivileges=no is set EXPLICITLY (unlike the other units, which
# omit the line and let it default on). A real live outage (2026-10-27)
# went through THREE fix attempts -- see install.sh's matching unit for
# the full writeup. Short version: omitting the line let it default on
# (several directives imply it). An explicit NoNewPrivileges=no did NOT
# fix that either -- confirmed live, a fresh restart with the override
# in place still showed NoNewPrivs: 1 in /proc. Removing just the
# obviously-seccomp directives ALSO didn't fix it -- a real bisection
# against the live production unit found ProtectKernelTunables=,
# ProtectKernelModules=, ProtectKernelLogs=, ProtectClock=, and
# ProtectHostname= each independently still force the flag too, since
# each blocks a specific kernel syscall via its own seccomp filter on
# top of its mount/capability restriction. Only PrivateTmp=,
# ProtectHome=, ProtectSystem=, ReadWritePaths=, and ProtectControlGroups=
# are actually safe on an unprivileged unit with no CAP_SYS_ADMIN --
# confirmed via that real bisection, each directive tested alone
# through a real restart + /proc/<pid>/status read, not reasoned about.
NoNewPrivileges=no
# PrivateTmp=yes is still safe and reinforces this same audit's own
# /tmp symlink-attack fixes elsewhere (deploy/run_restore.sh,
# install.sh's Mystic-installer download) -- an isolated /tmp, not a
# restricted one.
PrivateTmp=yes
# ProtectHome=yes is only correct for a non-/home install path (the
# default /opt/anetbbs shown throughout this file). install.sh/update.sh
# both switch this to ProtectHome=read-only automatically when
# INSTALL_DIR resolves under /home, /root, or /run/user -- a real
# outage (2026-10-27) happened because ProtectHome=yes unconditionally
# blocks exec of anything under /home regardless of ReadWritePaths=. If
# you're installing manually with INSTALL_DIR under one of those paths,
# change this line to `ProtectHome=read-only` (and keep ReadWritePaths=
# below pointed at your real INSTALL_DIR) or you will reproduce that
# outage.
ProtectHome=yes
ProtectControlGroups=yes
# ProtectSystem=full (not strict) -- the Service Control Center's
# self-upgrade feature writes across the whole /opt/anetbbs tree (git
# pull / docker build), not just data/, so strict confinement here
# would break it. full still locks down /usr, /boot, /etc. Found in a
# follow-up audit, same round that added the other directives above.
ProtectSystem=full
ReadWritePaths=/opt/anetbbs/data /opt/anetbbs/logs
ExecStart=/opt/anetbbs/venv/bin/python /opt/anetbbs/deploy/serve.py
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=mixed

[Install]
WantedBy=multi-user.target
