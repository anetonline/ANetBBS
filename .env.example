# ANetBBS Configuration
# Copy this file to .env and customize for your environment

# Environment (development, production, testing)
FLASK_ENV=production

# Secret key for sessions (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-this-in-production

# Database URL
# SQLite (default): sqlite:///data/anetbbs.db
# PostgreSQL: postgresql://user:password@localhost/anetbbs
DATABASE_URL=sqlite:///data/anetbbs.db

# Telnet Server Settings
TELNET_ENABLED=true
TELNET_HOST=0.0.0.0
TELNET_PORT=2233

# SSH Server Settings
SSH_ENABLED=true
SSH_HOST=0.0.0.0
SSH_PORT=2234
# Path to SSH host key file (auto-generated on first run if missing)
SSH_HOST_KEY_FILE=data/ssh_host_key

# rlogin Server Settings (INSECURE — disabled by default)
RLOGIN_ENABLED=false
RLOGIN_HOST=0.0.0.0
RLOGIN_PORT=513

# FTP server — serves the FileArea tree. Earns you the FTN nodelist
# `IFC` flag (Internet File transfer Capability) once advertised.
# Anonymous access is read-only and scoped to public areas; authenticated
# users see/upload according to per-area permissions.
FTP_ENABLED=false
FTP_HOST=0.0.0.0
FTP_PORT=21
FTP_ANON_ENABLED=true
# Optional FTPS — reuse the same Let's Encrypt cert nginx uses.
# Leave blank for plain FTP.
FTP_TLS_CERTFILE=
FTP_TLS_KEYFILE=
# Passive-mode port range. Open these on the firewall + forward to this
# host through NAT. Tight default keeps the exposed surface small.
FTP_PASV_PORTS=40000-40050
# Where to assemble the virtual FTP tree (symlinks to each FileArea's
# storage_path). Rebuilt on every server start.
FTP_ROOT_DIR=data/ftp_root
FTP_BANNER=ANetBBS FTP — file areas

# Web Server Settings
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Application Settings
BBS_NAME=ANetBBS
BBS_DESCRIPTION=A Modern BBS System
# Public domain (used for outbound netmail / nodelist links / share URLs)
BBS_DOMAIN=
# Public hostname clients should reach you at (overrides BBS_DOMAIN if set)
BBS_PUBLIC_HOST=
# Sysop name (used in BinkP banners, ANSI screen substitutions, etc.)
SYSOP_NAME=Sysop
# Sysop contact email
BBS_EMAIL=
# Geographic location (free-text) — shown in BBS info / nodelist
BBS_LOCATION=Earth
# Concurrent terminal nodes (1-100). NodeSpy + multinode chat use this cap.
BBS_NODES=8
# Idle session kick (seconds, 0 = never)
IDLE_TIMEOUT_SECONDS=0

# Logging
LOG_LEVEL=INFO

# Finger Server Settings (RFC 1288 — port 79 is privileged)
FINGER_LISTEN_HOST=0.0.0.0
FINGER_LISTEN_PORT=79

# BinkP Server Settings (FidoNet inbound mailer)
BINKP_LISTEN_HOST=0.0.0.0
BINKP_LISTEN_PORT=24554
# Your primary AKA (5D address) — required for inbound binkp auth
BINKP_OUR_ADDRESS=
BINKP_SYSTEM_NAME=ANetBBS

# Optional ClamAV virus scan on file uploads
CLAMSCAN_PATH=/usr/bin/clamscan

# IRC client / bridge: comma-separated list of #channels to log
IRC_LOG_CHANNELS=

# New User Verification (NUV) — email/sysop approval gate
NUV_ENABLED=false

# Files: minimum upload-to-download ratio (0 = disabled)
RATIO_MIN=0

# Games Settings
GAMES_ENABLED=true
GAMES_MAX_NODES=10
GAMES_SESSION_TIMEOUT=3600
# Paths to game runtimes
DOSBOX_PATH=/usr/bin/dosbox
DOSEMU_PATH=/usr/bin/dosemu
NODEJS_PATH=/usr/bin/node
# Mystic BBS Python game python interpreter (leave blank to use system python3)
MYSTIC_PYTHON_PATH=
# Mystic BBS runtime for .mps Pascal scripts
MYSTIC_BBS_PATH=/usr/local/bin/mystic

# Echomail Settings
ECHOMAIL_ENABLED=true
ECHOMAIL_POLL_ENABLED=true
ECHOMAIL_ORIGIN_LINE=ANetBBS - A Modern BBS System
ECHOMAIL_TEAR_LINE=--- ANetBBS

# MRC Bridge Settings
# MRC_BRIDGE_PORT should be WEB_PORT+1 (install.sh derives it this way
# automatically) -- 5001 here matches this file's WEB_PORT of 5000 above.
MRC_BRIDGE_HOST=localhost
MRC_BRIDGE_PORT=5001
MRC_BRIDGE_USE_SSL=false
MRC_BRIDGE_WS_PATH=/mrcws

# Bookkeeping only for install.sh/update.sh -- NOT read by the app itself.
# The standalone binkp/finger/mrc-bridge processes are gated purely by
# whether their systemd unit exists and is enabled, not by these values;
# they exist so update.sh can tell, on a self-heal run, whether a
# freshly-created unit should actually be started. Do not wire these
# into config.py -- that would create a second, conflicting source of
# truth for "is this feature on."
BINKP_ENABLED=false
FINGER_ENABLED=false
MRC_BRIDGE_ENABLED=false

# Inter-BBS Instant Messaging (MSP / RFC 1312) + SYSTAT (Synchronet IMSG
# companion). Both are privileged (<1024) ports by default -- if your
# platform can't grant CAP_NET_BIND_SERVICE (some container platforms),
# override these to unprivileged ports and remap at the network layer.
MSP_PORT=18
SYSTAT_PORT=11

# ANetBBS federation registry / ANotherNetwork QWK hub
# REGISTRY_MODE_ENABLED: this install itself IS the hub (bbs.a-net.fyi).
#   Leave false on every OTHER install -- do not confuse with
#   REGISTRY_SELF_REGISTER below (opposite meaning: "I am the hub" vs
#   "register WITH the hub"). Do not set both true on the same install.
REGISTRY_MODE_ENABLED=false
# REGISTRY_URL: the hub's base URL. Used both for federation
# registration/heartbeat and for the terminal "Apply for ANotherNetwork
# QWK node" wizard. Defaults to the public ANetBBS hub; set blank to
# disable federation/QWK-node-apply entirely.
REGISTRY_URL=https://bbs.a-net.fyi
# REGISTRY_SELF_REGISTER: if true, this (peer) BBS auto-registers
# itself against REGISTRY_URL on startup + heartbeats daily.
REGISTRY_SELF_REGISTER=false
